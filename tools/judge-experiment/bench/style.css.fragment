/* Layout: one column of decision trees, one per stage of a lookup, read top to
   bottom; every rule has an id (A1, D3.2 …) to point at. Colours are the
   app's own (qml/Theme.qml), so an outcome here looks like it does there. */
:root {
  --bg: #f5f6f8; --surface: #eceef2; --raised: #ffffff; --line: #d9dce3; --rail: #b9bec9;
  --text: #15171b; --dim: #555c69; --faint: #878e9b;
  --accent: #5a49d6; --accent-soft: #e6e2fb;
  --good: #167a55; --good-soft: #d9f1e7;
  --warn: #8a5a08; --warn-soft: #f8ebcf;
  --bad: #b83232; --bad-soft: #f8dede;
  --none: #555c69; --none-soft: #e2e5eb;
  --sans: ui-sans-serif, system-ui, "Segoe UI", "Noto Sans", "Noto Sans CJK JP", "Hiragino Sans", sans-serif;
  --mono: ui-monospace, "JetBrains Mono", "Cascadia Code", "SF Mono", Menlo, Consolas, monospace;
  color-scheme: light;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #0c0d10; --surface: #121419; --raised: #191c22; --line: #262a33; --rail: #3a404d;
    --text: #eef0f4; --dim: #9ba2af; --faint: #6f7684;
    --accent: #a99eff; --accent-soft: #25213f;
    --good: #4fd6a2; --good-soft: #12362a;
    --warn: #f2b866; --warn-soft: #3a2c12;
    --bad: #ff8a8a; --bad-soft: #401b1b;
    --none: #9ba2af; --none-soft: #1f232b;
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #0c0d10; --surface: #121419; --raised: #191c22; --line: #262a33; --rail: #3a404d;
  --text: #eef0f4; --dim: #9ba2af; --faint: #6f7684;
  --accent: #a99eff; --accent-soft: #25213f;
  --good: #4fd6a2; --good-soft: #12362a;
  --warn: #f2b866; --warn-soft: #3a2c12;
  --bad: #ff8a8a; --bad-soft: #401b1b;
  --none: #9ba2af; --none-soft: #1f232b;
  color-scheme: dark;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0; padding-block: 2.5rem 5rem; padding-inline: 1.25rem;
  background: var(--bg); color: var(--text);
  font: 15px/1.5 var(--sans);
}
main { max-width: 68rem; margin-inline: auto; display: flex; flex-direction: column; gap: 3rem; }
a { color: var(--accent); text-decoration-thickness: 1px; text-underline-offset: 2px; }
a:focus-visible, summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 3px; }
code, .num, .id { font-family: var(--mono); }
code { font-size: .86em; color: var(--dim); }

/* ---- page head ---- */
.head { display: flex; flex-direction: column; gap: .9rem; }
.head h1 { margin: 0; font-size: 2rem; line-height: 1.15; letter-spacing: -.01em; text-wrap: balance; }
.head p { margin: 0; max-width: 65ch; color: var(--dim); }
.stamp { font: 12px/1.4 var(--mono); color: var(--faint); }

.legend { display: flex; flex-wrap: wrap; gap: .5rem 1.1rem; align-items: center; font-size: 13px; color: var(--dim); }
.legend span { display: inline-flex; align-items: center; gap: .4rem; }

/* ---- the stages, in order ---- */
.flow { display: flex; flex-wrap: wrap; gap: .5rem; padding: 0; margin: 0; list-style: none; counter-reset: none; }
.flow li { display: flex; align-items: center; gap: .5rem; }
.flow li + li::before { content: "→"; color: var(--faint); }
.flow.aside { margin-top: .5rem; }
.flow.aside li + li::before { content: none; }   /* beside the lookup, not steps of it */
.flow a {
  display: flex; gap: .5rem; align-items: baseline; padding: .4rem .7rem;
  background: var(--raised); border: 1px solid var(--line); border-radius: 6px;
  color: var(--text); text-decoration: none; font-size: 13.5px;
}
.flow a:hover { border-color: var(--accent); }
.flow b { font-family: var(--mono); color: var(--accent); font-weight: 600; }

/* ---- a stage ---- */
section { display: flex; flex-direction: column; gap: 1rem; scroll-margin-top: 1rem; }
section > header { display: flex; flex-direction: column; gap: .35rem; border-top: 1px solid var(--line); padding-top: 1.25rem; }
section h2 { margin: 0; font-size: 1.3rem; line-height: 1.25; display: flex; gap: .6rem; align-items: baseline; text-wrap: balance; }
section h2 .tag { font-family: var(--mono); color: var(--accent); font-weight: 600; }
section h3 { margin: .75rem 0 0; font-size: 1rem; }
section > header p, .lede { margin: 0; max-width: 70ch; color: var(--dim); }
.where { font: 12px/1.4 var(--mono); color: var(--faint); }

/* ---- the trees ----
   ul.tree: a node's children hang from a rail on the left. Each child is a
   row: [id] [when …] → [what happens] [why]. A child that asks a further
   question carries its own ul. */
.scroll { overflow-x: auto; }
.tree, .tree ul { list-style: none; margin: 0; padding: 0; }
.tree { min-width: 30rem; }
.tree ul { margin-left: .55rem; padding-left: 1.35rem; }
.tree li { position: relative; padding: .28rem 0; scroll-margin-top: 1rem; }
.tree ul > li::before {            /* the elbow into this row */
  content: ""; position: absolute; left: -1.35rem; top: 1.02rem; width: 1.05rem;
  border-top: 1.5px solid var(--rail);
}
.tree ul > li::after {             /* the rail past this row */
  content: ""; position: absolute; left: -1.35rem; top: -.28rem; bottom: 0;
  border-left: 1.5px solid var(--rail);
}
.tree ul > li:last-child::after { bottom: auto; height: 1.3rem; }
.tree li:target > .row { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 4px; }

.row { display: flex; flex-wrap: wrap; align-items: baseline; gap: .3rem .5rem; min-height: 1.5rem; }
.id { font-size: 11.5px; color: var(--faint); min-width: 2.3rem; text-decoration: none; }
a.id:hover { color: var(--accent); }
.when { color: var(--text); }
.when::after { content: "→"; color: var(--faint); margin-left: .5rem; }
.when.last::after { content: none; }
/* the reason, always on its own line under the row, at a readable width */
.why { color: var(--dim); font-size: 13.5px; flex: 0 0 100%; padding-right: max(0px, calc(100% - 44rem)); }
.row:has(> .id) > .why { padding-left: 2.8rem; padding-right: max(0px, calc(100% - 46.8rem)); }
.num { font-size: .86em; font-weight: 600; background: var(--surface); border: 1px solid var(--line); border-radius: 4px; padding: 0 .3em; white-space: nowrap; }

/* what a row comes to */
.q, .out { display: inline-block; padding: .08rem .55rem; border-radius: 5px; font-weight: 600; font-size: 13.5px; line-height: 1.45; }
.q { background: var(--raised); border: 1.5px solid var(--text); border-radius: 2px; }
.q.order::after { content: " — first that applies"; font-weight: 400; color: var(--dim); }
.out { border: 1.5px solid transparent; }
.out.ok { background: var(--good-soft); color: var(--good); border-color: var(--good); }
.out.review { background: var(--warn-soft); color: var(--warn); border-color: var(--warn); }
.out.no { background: var(--bad-soft); color: var(--bad); border-color: var(--bad); }
.out.none { background: var(--none-soft); color: var(--none); border-color: var(--rail); }
.out.later { background: var(--accent-soft); color: var(--accent); border-color: var(--accent); }
.out.go { background: transparent; color: var(--text); border: 1.5px dashed var(--rail); font-weight: 500; }
.out.go a { color: inherit; }

/* a definition several trees lean on */
.defs { display: grid; grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr)); gap: 1rem; }
.def { background: var(--raised); border: 1px solid var(--line); border-radius: 8px; padding: .9rem 1rem; min-width: 0; scroll-margin-top: 1rem; }
.def:target { border-color: var(--accent); }
.def h3 { margin: 0 0 .4rem; font-size: .95rem; display: flex; gap: .5rem; align-items: baseline; }
.def h3 .id { color: var(--accent); min-width: 0; font-size: 12.5px; }
.def p { margin: 0 0 .4rem; color: var(--dim); font-size: 13.5px; }
.def ul { margin: 0; padding-left: 1.1rem; font-size: 13.5px; display: flex; flex-direction: column; gap: .2rem; }

table { border-collapse: collapse; width: 100%; font-size: 13.5px; }
th, td { text-align: left; padding: .4rem .7rem .4rem 0; border-bottom: 1px solid var(--line); vertical-align: top; }
th { color: var(--faint); font-weight: 600; font-size: 12px; text-transform: uppercase; letter-spacing: .05em; }
td.n { font-family: var(--mono); font-variant-numeric: tabular-nums; white-space: nowrap; font-weight: 600; }
td code { white-space: nowrap; }
.words { color: var(--dim); font-size: 13px; line-height: 1.7; max-width: 100ch; }
.words b { color: var(--text); font-weight: 600; }

/* ---- a proposed change, drawn like a diff ----
   Only ever in docs/import-rules.proposed.html (see CLAUDE.md): additions in
   green, removals in red and left in place. The report itself carries none. */
[hidden] { display: none !important; }
.proposal { margin: 0; padding: .6rem .8rem; border: 1.5px solid var(--accent); border-radius: 6px; background: var(--accent-soft); color: var(--text); max-width: none; }
ins, del { border-radius: 3px; padding: 0 .2em; }
ins { background: var(--good-soft); color: var(--good); text-decoration: none; }
del { background: var(--bad-soft); color: var(--bad); text-decoration: line-through; }
.tree li.added .row, .def.added, tr.added > td { background: var(--good-soft); }
.tree li.removed .row, .def.removed, tr.removed > td { background: var(--bad-soft); text-decoration: line-through; text-decoration-color: var(--bad); }
.tree li.added .row, .tree li.removed .row { border-radius: 4px; padding-inline: .3rem; }
.def.added { border-color: var(--good); }
.def.removed { border-color: var(--bad); }

@media (max-width: 40rem) {
  body { font-size: 14px; }
  .row:has(> .id) > .why { padding-left: 0; }
  .id { min-width: 0; }
}
@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
@media print { body { background: #fff; } .tree li { break-inside: avoid; } }
